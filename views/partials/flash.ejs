<% if (success && success.length) { %>
    <div class="max-w-5xl mx-auto px-6 mt-4">
        <div
            class="bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300 border border-green-300 dark:border-green-700 rounded-xl px-4 py-3 text-sm">
            <%= success %>
        </div>
    </div>
    <% } %>

        <% if (error && error.length) { %>
            <div class="max-w-5xl mx-auto px-6 mt-4">
                <div
                    class="bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300 border border-red-300 dark:border-red-700 rounded-xl px-4 py-3 text-sm">
                    <%= error %>
                </div>
            </div>
            <% } %>