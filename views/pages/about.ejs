<section class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold mb-6">About Me</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-12">
        B.Tech Electrical and Electronics Engineering student at NIT Calicut, building across AI/ML, embedded systems,
        and full-stack web development.
    </p>

    <h2 class="text-2xl font-bold mb-6">Skills</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
        <% skills.forEach(skill=> { %>
            <div class="card">
                <p class="font-medium mb-1">
                    <%= skill.name %>
                </p>
                <p class="text-xs text-gray-500 dark:text-gray-500">
                    <%= skill.category %>
                </p>
                <div class="flex gap-1 mt-2">
                    <% for (let i=1; i <=5; i++) { %>
                        <span
                            class="w-2 h-2 rounded-full <%= i <= skill.proficiency ? 'bg-accent' : 'bg-gray-300 dark:bg-gray-700' %>"></span>
                        <% } %>
                </div>
            </div>
            <% }) %>
    </div>

    <h2 class="text-2xl font-bold mb-6">Certificates</h2>
    <% if (certificates.length===0) { %>
        <p class="text-gray-600 dark:text-gray-400">None added yet.</p>
        <% } else { %>
            <div class="grid md:grid-cols-2 gap-4">
                <% certificates.forEach(cert=> { %>
                    <div class="card">
                        <h3 class="font-bold">
                            <%= cert.title %>
                        </h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400">
                            <%= cert.issuer %>
                        </p>
                    </div>
                    <% }) %>
            </div>
            <% } %>
</section>