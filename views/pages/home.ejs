<section class="relative max-w-5xl mx-auto px-6 py-32 text-center overflow-hidden">
    <p class="font-mono text-xs uppercase tracking-widest mb-4" style="color: var(--color-accent);">
        // signal_source: NIT Calicut, EEE
    </p>
    <h1 class="text-5xl md:text-6xl font-bold mb-4">Arun A</h1>
    <p class="text-lg font-mono" style="color: var(--color-muted);">
        AI/ML Engineer &middot; Full-Stack Developer &middot; Embedded Systems
    </p>
</section>

<section class="max-w-5xl mx-auto px-6 py-12 relative trace-line">
    <div class="trace-pulse"></div>
    <h2 class="text-3xl font-bold mb-8 text-center">Featured Projects</h2>
    <div class="grid md:grid-cols-3 gap-6">
        <% featuredProjects.forEach(project=> { %>
            <a href="/projects/<%= project.slug %>" class="card block hover:scale-[1.02]">
                <h3 class="font-display text-xl font-bold mb-2">
                    <%= project.title %>
                </h3>
                <p class="text-sm mb-4" style="color: var(--color-muted);">
                    <%= project.description %>
                </p>
                <div class="flex flex-wrap gap-2">
                    <% project.techStack.forEach(tech=> { %>
                        <span class="chip">
                            <%= tech %>
                        </span>
                        <% }) %>
                </div>
            </a>
            <% }) %>
    </div>
</section>