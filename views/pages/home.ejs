<section class="max-w-5xl mx-auto px-6 py-24 text-center">
    <h1 class="text-5xl font-bold mb-4">Hi, I'm Arun A</h1>
    <p class="text-gray-600 dark:text-gray-400 text-lg">AI/ML Engineer & Full-Stack Developer</p>
</section>

<section class="max-w-5xl mx-auto px-6 py-12">
    <h2 class="text-3xl font-bold mb-8">Featured Projects</h2>
    <div class="grid md:grid-cols-3 gap-6">
        <% featuredProjects.forEach(project=> { %>
            <a href="/projects/<%= project.slug %>" class="card block hover:scale-[1.02] transition-transform">
                <h3 class="font-display text-xl font-bold mb-2">
                    <%= project.title %>
                </h3>
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                    <%= project.description %>
                </p>
                <div class="flex flex-wrap gap-2">
                    <% project.techStack.forEach(tech=> { %>
                        <span class="text-xs px-2 py-1 rounded-full bg-accent/10 text-accent">
                            <%= tech %>
                        </span>
                        <% }) %>
                </div>
            </a>
            <% }) %>
    </div>
</section>