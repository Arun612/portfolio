<section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold mb-8">Manage Experience</h1>

    <form action="/admin/experience" method="POST" class="card space-y-3 mb-8">
        <div>
            <label class="block text-sm font-medium mb-1">Role</label>
            <input type="text" name="role" required
                class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-white/10 dark:bg-white/5" />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Organization</label>
            <input type="text" name="organization" required
                class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-white/10 dark:bg-white/5" />
        </div>
        <div class="flex gap-3">
            <div class="flex-1">
                <label class="block text-sm font-medium mb-1">Start Date</label>
                <input type="date" name="startDate" required
                    class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-white/10 dark:bg-white/5" />
            </div>
            <div class="flex-1">
                <label class="block text-sm font-medium mb-1">End Date (blank = Present)</label>
                <input type="date" name="endDate"
                    class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-white/10 dark:bg-white/5" />
            </div>
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Type</label>
            <select name="type"
                class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-white/10 dark:bg-white/5">
                <option value="Internship">Internship</option>
                <option value="Project">Project</option>
                <option value="Competition">Competition</option>
                <option value="Coursework">Coursework</option>
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Description</label>
            <textarea name="description" rows="3"
                class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-white/10 dark:bg-white/5"></textarea>
        </div>
        <button type="submit" class="btn-primary">Add Experience</button>
    </form>

    <div class="space-y-2">
        <% experience.forEach(exp=> { %>
            <div class="card flex justify-between items-center py-3">
                <span>
                    <%= exp.role %> <span class="text-xs text-gray-500">— <%= exp.organization %></span>
                </span>
                <form action="/admin/experience/<%= exp._id %>?_method=DELETE" method="POST"
                    onsubmit="return confirm('Remove this entry?');">
                    <button type="submit" class="text-red-500 hover:text-red-600 text-sm font-medium">Remove</button>
                </form>
            </div>
            <% }) %>
    </div>
</section>