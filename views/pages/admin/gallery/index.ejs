<section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold mb-8">Manage Gallery</h1>

    <form action="/admin/gallery" method="POST" enctype="multipart/form-data" class="card space-y-3 mb-8">
        <div>
            <label class="block text-sm font-medium mb-1">Image</label>
            <input type="file" name="image" accept="image/*" required />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Caption</label>
            <input type="text" name="caption"
                class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-white/10 dark:bg-white/5" />
        </div>
        <button type="submit" class="btn-primary">Add Image</button>
    </form>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        <% images.forEach(img=> { %>
            <div class="relative group">
                <img src="<%= img.imageUrl %>" class="w-full h-32 object-cover rounded-xl" />
                <form action="/admin/gallery/<%= img._id %>?_method=DELETE" method="POST"
                    onsubmit="return confirm('Remove this image?');" class="absolute top-2 right-2">
                    <button type="submit" class="bg-red-500 text-white text-xs px-2 py-1 rounded-lg">Delete</button>
                </form>
            </div>
            <% }) %>
    </div>
</section>