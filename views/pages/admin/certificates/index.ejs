<section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold mb-8">Manage Certificates</h1>

    <form action="/admin/certificates" method="POST" enctype="multipart/form-data" class="card space-y-3 mb-8">
        <div>
            <label class="block text-sm font-medium mb-1">Title</label>
            <input type="text" name="title" required
                class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-white/10 dark:bg-white/5" />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Issuer</label>
            <input type="text" name="issuer" required
                class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-white/10 dark:bg-white/5" />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Issue Date</label>
            <input type="date" name="issueDate"
                class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-white/10 dark:bg-white/5" />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Credential URL</label>
            <input type="url" name="credentialUrl"
                class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-white/10 dark:bg-white/5" />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Image</label>
            <input type="file" name="image" accept="image/*" />
        </div>
        <button type="submit" class="btn-primary">Add Certificate</button>
    </form>

    <div class="space-y-2">
        <% certificates.forEach(cert=> { %>
            <div class="card flex justify-between items-center py-3">
                <span>
                    <%= cert.title %> <span class="text-xs text-gray-500">— <%= cert.issuer %></span>
                </span>
                <form action="/admin/certificates/<%= cert._id %>?_method=DELETE" method="POST"
                    onsubmit="return confirm('Remove this certificate?');">
                    <button type="submit" class="text-red-500 hover:text-red-600 text-sm font-medium">Remove</button>
                </form>
            </div>
            <% }) %>
    </div>
</section>