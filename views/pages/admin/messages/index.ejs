<section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold mb-8">Messages</h1>
    <div class="space-y-4">
        <% messages.forEach(msg=> { %>
            <div class="card <%= msg.read ? 'opacity-60' : '' %>">
                <div class="flex justify-between items-start mb-2">
                    <div>
                        <p class="font-bold">
                            <%= msg.name %>
                        </p>
                        <p class="text-sm text-gray-500">
                            <%= msg.email %>
                        </p>
                    </div>
                    <span class="text-xs text-gray-400">
                        <%= msg.createdAt.toLocaleDateString() %>
                    </span>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-3">
                    <%= msg.message %>
                </p>
                <div class="flex gap-3">
                    <% if (!msg.read) { %>
                        <form action="/admin/messages/<%= msg._id %>/read?_method=PUT" method="POST">
                            <button type="submit" class="text-accent text-sm font-medium">Mark Read</button>
                        </form>
                        <% } %>
                            <form action="/admin/messages/<%= msg._id %>?_method=DELETE" method="POST"
                                onsubmit="return confirm('Delete this message?');">
                                <button type="submit"
                                    class="text-red-500 hover:text-red-600 text-sm font-medium">Delete</button>
                            </form>
                </div>
            </div>
            <% }) %>
    </div>
</section>