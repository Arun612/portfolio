<section class="max-w-2xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold mb-8">Edit Post</h1>
    <form action="/admin/blogs/<%= blog._id %>?_method=PUT" method="POST" class="space-y-5">
        <div>
            <label class="block text-sm font-medium mb-1">Title</label>
            <input type="text" name="title" value="<%= blog.title %>" required
                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-white/10 dark:bg-white/5" />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Content (Markdown)</label>
            <textarea name="content" required rows="10"
                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-white/10 dark:bg-white/5 font-mono text-sm"><%= blog.content %></textarea>
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Tags (comma-separated)</label>
            <input type="text" name="tags" value="<%= blog.tags.join(', ') %>"
                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-white/10 dark:bg-white/5" />
        </div>
        <div class="flex items-center gap-2">
            <input type="checkbox" name="published" id="published" <%=blog.published ? 'checked' : '' %> class="w-4 h-4"
            />
            <label for="published" class="text-sm">Published</label>
        </div>
        <button type="submit" class="btn-primary w-full">Update Post</button>
    </form>
</section>