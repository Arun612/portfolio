<section class="max-w-5xl mx-auto px-6 py-16">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">Manage Blog</h1>
        <a href="/admin/blogs/new" class="btn-primary">+ New Post</a>
    </div>
    <div class="space-y-4">
        <% blogs.forEach(blog=> { %>
            <div class="card flex justify-between items-center">
                <div>
                    <h2 class="font-bold">
                        <%= blog.title %>
                    </h2>
                    <p class="text-sm text-gray-500">
                        <%= blog.published ? 'Published' : 'Draft' %>
                    </p>
                </div>
                <div class="flex gap-3">
                    <a href="/admin/blogs/<%= blog._id %>/edit" class="nav-link">Edit</a>
                    <form action="/admin/blogs/<%= blog._id %>?_method=DELETE" method="POST"
                        onsubmit="return confirm('Delete this post?');">
                        <button type="submit"
                            class="text-red-500 hover:text-red-600 text-sm font-medium">Delete</button>
                    </form>
                </div>
            </div>
            <% }) %>
    </div>
</section>