<section class="max-w-5xl mx-auto px-6 py-16">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">Manage Projects</h1>
        <a href="/admin/projects/new" class="btn-primary">+ New Project</a>
    </div>

    <div class="space-y-4">
        <% projects.forEach(project=> { %>
            <div class="card flex justify-between items-center">
                <div>
                    <h2 class="font-bold">
                        <%= project.title %>
                    </h2>
                    <p class="text-sm text-gray-500">
                        <%= project.category %>
                            <%= project.featured ? '· Featured' : '' %>
                    </p>
                </div>
                <div class="flex gap-3">
                    <a href="/admin/projects/<%= project._id %>/edit" class="nav-link">Edit</a>
                    <form action="/admin/projects/<%= project._id %>?_method=DELETE" method="POST"
                        onsubmit="return confirm('Delete this project?');">
                        <button type="submit"
                            class="text-red-500 hover:text-red-600 text-sm font-medium">Delete</button>
                    </form>
                </div>
            </div>
            <% }) %>
    </div>
</section>