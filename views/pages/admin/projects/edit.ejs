<section class="max-w-2xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold mb-8">Edit Project</h1>
    <form action="/admin/projects/<%= project._id %>?_method=PUT" method="POST" enctype="multipart/form-data"
        class="space-y-5">
        <div>
            <label class="block text-sm font-medium mb-1">Title</label>
            <input type="text" name="title" value="<%= project.title %>" required
                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-white/10 dark:bg-white/5" />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Short Description</label>
            <textarea name="description" required rows="2"
                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-white/10 dark:bg-white/5"><%= project.description %></textarea>
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Long Description</label>
            <textarea name="longDescription" rows="5"
                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-white/10 dark:bg-white/5"><%= project.longDescription %></textarea>
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Tech Stack (comma-separated)</label>
            <input type="text" name="techStack" value="<%= project.techStack.join(', ') %>"
                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-white/10 dark:bg-white/5" />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Category</label>
            <select name="category"
                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-white/10 dark:bg-white/5">
                <option value="AI/ML" <%=project.category==='AI/ML' ? 'selected' : '' %>>AI/ML</option>
                <option value="Web" <%=project.category==='Web' ? 'selected' : '' %>>Web</option>
                <option value="Hardware" <%=project.category==='Hardware' ? 'selected' : '' %>>Hardware</option>
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">GitHub URL</label>
            <input type="url" name="githubUrl" value="<%= project.githubUrl %>"
                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-white/10 dark:bg-white/5" />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Live URL</label>
            <input type="url" name="liveUrl" value="<%= project.liveUrl %>"
                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-white/10 dark:bg-white/5" />
        </div>
        <% if (project.images && project.images[0]) { %>
            <img src="<%= project.images[0] %>" class="w-40 rounded-xl" />
            <% } %>
                <div>
                    <label class="block text-sm font-medium mb-1">Replace Image (optional)</label>
                    <input type="file" name="image" accept="image/*" class="w-full" />
                </div>
                <div class="flex items-center gap-2">
                    <input type="checkbox" name="featured" id="featured" <%=project.featured ? 'checked' : '' %>
                    class="w-4 h-4" />
                    <label for="featured" class="text-sm">Featured on homepage</label>
                </div>
                <button type="submit" class="btn-primary w-full">Update Project</button>
    </form>
</section>