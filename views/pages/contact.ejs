<section class="max-w-md mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold mb-8">Get in Touch</h1>
    <form action="/contact" method="POST" class="space-y-5">
        <div>
            <label class="block text-sm font-medium mb-1">Name</label>
            <input type="text" name="name" required
                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-white/10 dark:bg-white/5" />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Email</label>
            <input type="email" name="email" required
                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-white/10 dark:bg-white/5" />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Message</label>
            <textarea name="message" required rows="5"
                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-white/10 dark:bg-white/5"></textarea>
        </div>
        <button type="submit" class="btn-primary w-full">Send Message</button>
    </form>
</section>